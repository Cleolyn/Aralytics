{
  "name": "aralytics-monorepo",
  "version": "1.0.0",
  "description": "Aralytics (Ponce AP10 Learning Hub) - LMS, Assessment & Automated Intervention System",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "db:init": "npm run db:init --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:samples": "npm run db:samples --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "build:cloudflare": "npm run build && node scripts/prepare-worker.cjs",
    "deploy:cloudflare": "npm run build:cloudflare && npm run db:init && npx wrangler d1 migrations apply aralytics-uploads --remote && npx wrangler deploy",
    "admin:grant": "npm run admin:grant --workspace server --"
  },
  "keywords": [
    "aralytics",
    "ap10",
    "lms",
    "ilaw",
    "assessment",
    "intervention"
  ],
  "author": "Antigravity Loop Architect",
  "license": "ISC",
  "dependencies": {
    "@hugeicons/react": "^1.1.10"
  }
}
