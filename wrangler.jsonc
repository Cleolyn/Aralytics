{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aralytics",
  "account_id": "f83df8d94122bb2d5f4cf58d91806b7d",
  "main": "server/src/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "aralytics.cleolyn.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "DB_DIALECT": "turso"
  },
  "alias": {
    "pdfkit": "./.cloudflare/pdfkit.cjs",
    "@libsql/client": "./.cloudflare/libsql-client.mjs"
  },
  "build": {
    "command": "node scripts/prepare-worker.cjs"
  },
  "define": {
    "__dirname": "\"/bundle\"",
    "__filename": "\"/bundle/pdfkit.js\""
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "FILES_DB_1",
      "database_name": "aralytics-uploads",
      "database_id": "fd2e27f6-d473-4284-a13b-c2a19684574c",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_2",
      "database_name": "aralytics-files-2",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_3",
      "database_name": "aralytics-files-3",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_4",
      "database_name": "aralytics-files-4",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_5",
      "database_name": "aralytics-files-5",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_6",
      "database_name": "aralytics-files-6",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_7",
      "database_name": "aralytics-files-7",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_8",
      "database_name": "aralytics-files-8",
      "database_id": "TODO-create-with-wrangler",
      "migrations_dir": "server/migrations/uploads"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
