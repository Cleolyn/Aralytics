{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aralytics",
  "account_id": "f83df8d94122bb2d5f4cf58d91806b7d",
  "main": "server/src/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "aralytics.cleolyn.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "DB_DIALECT": "turso"
  },
  "alias": {
    "pdfkit": "./.cloudflare/pdfkit.cjs",
    "@libsql/client": "./.cloudflare/libsql-client.mjs"
  },
  "build": {
    "command": "node scripts/prepare-worker.cjs"
  },
  "define": {
    "__dirname": "\"/bundle\"",
    "__filename": "\"/bundle/pdfkit.js\""
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "FILES_DB_1",
      "database_name": "aralytics-uploads",
      "database_id": "fd2e27f6-d473-4284-a13b-c2a19684574c",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_2",
      "database_name": "aralytics-files-2",
      "database_id": "fff4aa31-8a1d-401d-aded-15954d0bf1c3",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_3",
      "database_name": "aralytics-files-3",
      "database_id": "564c1cb9-cfde-41a2-bebb-60d7a4a4704b",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_4",
      "database_name": "aralytics-files-4",
      "database_id": "133aea52-6d1c-4a6c-aff0-417d81a33cc8",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_5",
      "database_name": "aralytics-files-5",
      "database_id": "396dd6e7-ba81-4339-a330-6d3ad685da9a",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_6",
      "database_name": "aralytics-files-6",
      "database_id": "0707f68f-0516-4dfe-a09a-cdaea8630e56",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_7",
      "database_name": "aralytics-files-7",
      "database_id": "11af1ea3-edcb-4a1b-b475-4049179e6393",
      "migrations_dir": "server/migrations/uploads"
    },
    {
      "binding": "FILES_DB_8",
      "database_name": "aralytics-files-8",
      "database_id": "9fd0f5ac-08ea-4152-b2dd-5182f9133c04",
      "migrations_dir": "server/migrations/uploads"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
