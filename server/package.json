{
  "name": "server",
  "version": "1.0.0",
  "description": "Aralytics REST API (Express + Clerk) with SQLite, Turso, or MySQL storage",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seeds",
    "db:samples": "node src/db/seeds --outputs",
    "test": "node test/run.js",
    "test:enrollment": "node test/run.js enrollment_flow",
    "test:redesign": "node test/run.js redesign_flow offline_policy"
  },
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.20.2",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  }
}
