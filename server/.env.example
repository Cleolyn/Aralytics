# Copy to server/.env and fill in the values.

# --- API ---------------------------------------------------------------
PORT=5001
NODE_ENV=development
# Comma-separated allowed origins; leave unset (or *) to allow all.
# CORS_ORIGIN=http://localhost:3000

# --- Clerk (required) --------------------------------------------------
# https://dashboard.clerk.com -> your application -> API keys
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
# The client falls back to this value if client/.env is not set.
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# --- Database ----------------------------------------------------------
# sqlite (default) | turso | mysql
DB_DIALECT=sqlite

# SQLite: file path relative to server/ (or absolute, or :memory:)
DB_SQLITE_PATH=aralytics.sqlite

# Turso / libSQL (used when DB_DIALECT=turso, or when TURSO_DATABASE_URL is set and DB_DIALECT is unset)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# MySQL (DB_DIALECT=mysql). Create the schema with src/db/schema.mysql.sql.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=aralytics_db
