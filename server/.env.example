# Copy to server/.env and fill in the values.

# --- API ---------------------------------------------------------------
PORT=5001
NODE_ENV=development
# Comma-separated allowed origins; leave unset (or *) to allow all.
# CORS_ORIGIN=http://localhost:3000

# --- Clerk (required) --------------------------------------------------
# https://dashboard.clerk.com -> your application -> API keys
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
# The client falls back to this value if client/.env is not set.
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# --- File storage (all optional) ----------------------------------------
# Signs upload and download links. Required in production (npx wrangler secret put FILE_TOKEN_SECRET);
# local development generates a random one per run.
# FILE_TOKEN_SECRET=a-long-random-string
# Where files are kept when no D1 database is bound (local development). Default: server/uploads/files
# FILES_LOCAL_ROOT=
# Limits, in bytes. Defaults: teachers 15 MB per file and 1 GB total, students 10 MB and 50 MB,
# 450 MB per D1 database, 3.5 GB across the site. Do not change FILES_CHUNK_BYTES once files exist.
# FILES_TEACHER_MAX_FILE=15728640
# FILES_TEACHER_QUOTA=1073741824
# FILES_STUDENT_MAX_FILE=10485760
# FILES_STUDENT_QUOTA=52428800
# FILES_SHARD_CAP_BYTES=471859200
# FILES_SITE_CAP_BYTES=3758096384
# FILES_CHUNK_BYTES=1048576

# --- Database ----------------------------------------------------------
# sqlite (default) | turso | mysql
DB_DIALECT=sqlite

# SQLite: file path relative to server/ (or absolute, or :memory:)
DB_SQLITE_PATH=aralytics.sqlite

# Turso / libSQL (used when DB_DIALECT=turso, or when TURSO_DATABASE_URL is set and DB_DIALECT is unset)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# MySQL (DB_DIALECT=mysql). Create the schema with src/db/schema.mysql.sql.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=aralytics_db
